<?xml version="1.0" encoding="utf-8"?>
<!-- A guide programme: name, then "2:00 – 4:30 PM" and its badges. The background (and the
     now-playing progress bar) is drawn by ProgramGridCell. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp"
    tools:layout_width="210dp">

    <TextView
        android:id="@+id/programName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/no_program_data"
        android:textColor="@color/guide_text"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/programName"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="5dp"
        android:divider="@drawable/blank10x10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <ImageView
        android:id="@+id/recIndicator"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        android:layout_alignTop="@+id/infoRow"
        android:layout_alignBottom="@+id/infoRow"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/infoRow"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_record_series_red" />
</RelativeLayout>
