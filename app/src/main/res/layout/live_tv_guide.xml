<?xml version="1.0" encoding="utf-8"?>
<!-- The Live TV guide, Tentacle style: a header (Live TV, Favorites / All, the days that have
     guide data, Recordings / Schedule / Series, clock), the focused programme, then the grid. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tentacle_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/liveTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/lbl_guide_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/viewToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/guide_toggle_bg"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/viewFavorites"
                style="@style/GuideChip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:nextFocusLeft="@id/viewFavorites"
                tools:text="Favorites 3" />

            <TextView
                android:id="@+id/viewAll"
                style="@style/GuideChip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                tools:text="All 5,669" />
        </LinearLayout>

        <!-- Today … the last day with guide data; hidden when only today has data -->
        <LinearLayout
            android:id="@+id/days"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:orientation="horizontal" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/recordingsButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:drawableStart="@drawable/guide_ic_record"
            android:text="@string/lbl_recordings" />

        <TextView
            android:id="@+id/scheduleButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/guide_ic_tv_timer"
            android:text="@string/lbl_schedule" />

        <TextView
            android:id="@+id/seriesButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/guide_ic_record_series"
            android:text="@string/lbl_series" />

        <org.jellyfin.androidtv.ui.ClockUserView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- The focused programme -->
    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/programImage"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_below="@id/header"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/programImage"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:layout_toEndOf="@id/programImage"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/programTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_alignStart="@id/title"
        android:layout_marginEnd="12dp"
        android:maxLines="1"
        android:textColor="@color/tentacle_accent"
        android:textSize="14sp"
        tools:text="2:00 – 4:30 PM" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignTop="@id/programTime"
        android:layout_toStartOf="@id/filterButton"
        android:layout_toEndOf="@id/programTime"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/programTime"
        android:layout_alignStart="@id/title"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@id/filterButton"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:textColor="@color/guide_text_muted"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/optionsButton"
        style="@style/Button.Icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignBottom="@id/programImage"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:background="@drawable/jellyfin_button"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings" />

    <ImageButton
        android:id="@+id/filterButton"
        style="@style/Button.Icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignBottom="@id/programImage"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/optionsButton"
        android:background="@drawable/jellyfin_button"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_filter" />

    <!-- Back to now, after paging ahead -->
    <ImageButton
        android:id="@+id/resetButton"
        style="@style/Button.Icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignBottom="@id/programImage"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/filterButton"
        android:background="@drawable/jellyfin_button"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_time"
        android:visibility="gone" />

    <!-- Timeline: the day shown, the half hours and a "now" pill -->
    <TextView
        android:id="@+id/displayDate"
        android:layout_width="160sp"
        android:layout_height="32dp"
        android:layout_below="@id/programImage"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:background="@color/timeline_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:textColor="@color/guide_text_muted"
        android:textSize="13sp"
        tools:text="Today" />

    <HorizontalScrollView
        android:id="@+id/timelineHScroller"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignTop="@id/displayDate"
        android:layout_toEndOf="@id/displayDate"
        android:background="@color/timeline_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/timeline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/nowPill"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/guide_now_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="2:56 PM" />
        </FrameLayout>
    </HorizontalScrollView>

    <org.jellyfin.androidtv.ui.ObservableScrollView
        android:id="@+id/channelScroller"
        android:layout_width="160sp"
        android:layout_height="match_parent"
        android:layout_below="@id/displayDate"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="20sp"
        android:background="@color/channel_scroller_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/channels"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:orientation="vertical" />
    </org.jellyfin.androidtv.ui.ObservableScrollView>

    <org.jellyfin.androidtv.ui.ObservableScrollView
        android:id="@+id/programVScroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/channelScroller"
        android:layout_alignBottom="@id/channelScroller"
        android:layout_toEndOf="@id/channelScroller"
        android:background="@color/program_scroller_bg"
        android:scrollbars="none">

        <org.jellyfin.androidtv.ui.ObservableHorizontalScrollView
            android:id="@+id/programHScroller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/programRows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- "Now" -->
                <View
                    android:id="@+id/nowLine"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/tentacle_accent"
                    android:focusable="false"
                    android:visibility="gone" />
            </FrameLayout>
        </org.jellyfin.androidtv.ui.ObservableHorizontalScrollView>
    </org.jellyfin.androidtv.ui.ObservableScrollView>

    <TextView
        android:id="@+id/channelsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/guide_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/filterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:textColor="@color/guide_text_muted"
        android:textSize="12sp" />

    <!-- Favorites with none yet: one plain line and the way to All -->
    <LinearLayout
        android:id="@+id/emptyFavorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:background="@color/tentacle_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="72dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/emptyFavoritesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/msg_guide_no_favorites"
            android:textColor="@color/guide_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/showAllButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/lbl_guide_show_all" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/spinner"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/header"
        android:background="@color/tentacle_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="120dp"
            android:text="@string/lbl_loading_elipses"
            android:textColor="@color/guide_text_muted"
            android:textSize="16sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView9"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:indeterminateTint="@color/tentacle_accent" />

    </RelativeLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settingsFilters"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settingsOptions"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
