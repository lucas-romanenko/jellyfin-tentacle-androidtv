<?xml version="1.0" encoding="utf-8"?>
<!-- A guide row's channel: logo, name, number, and a heart when it is a favourite -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/channelImage"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/guide_logo_bg"
        android:padding="2dp"
        android:scaleType="centerInside" />

    <!-- Its place in a multi-view pick (1-4), over the logo's corner -->
    <TextView
        android:id="@+id/pickBadge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignStart="@id/channelImage"
        android:layout_alignTop="@id/channelImage"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:background="@drawable/guide_pick_badge"
        android:elevation="2dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/favImage"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_heart_red"
        android:visibility="gone" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/channelImage"
        android:layout_marginStart="8dp"
        android:layout_marginTop="-3dp"
        android:layout_toStartOf="@id/favImage"
        android:layout_toEndOf="@id/channelImage"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/guide_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/channelName"
        android:layout_alignStart="@id/channelName"
        android:layout_toStartOf="@id/favImage"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/guide_text_muted"
        android:textSize="11sp" />
</RelativeLayout>
