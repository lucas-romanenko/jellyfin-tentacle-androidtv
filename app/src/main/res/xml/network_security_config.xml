<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools" >
    <!--
        Cleartext is intentionally permitted: users connect to LAN HTTP Jellyfin/Emby
        servers at arbitrary, user-entered addresses. User-installed CAs are NOT trusted
        to reduce MITM exposure (only the system trust store is honoured for TLS).
    -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" >
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
