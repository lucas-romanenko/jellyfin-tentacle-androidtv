<?xml version="1.0" encoding="utf-8"?>
<!-- A guide channel name cell: the channel column's colour with a thin line under each row -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221f3a" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/channel_scroller_bg" />
        </shape>
    </item>
</layer-list>
