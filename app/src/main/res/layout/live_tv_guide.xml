<?xml version="1.0" encoding="utf-8"?>
<!-- The Live TV guide, Tentacle style: a header (Live TV, Favorites / All, Multi-view,
     Recordings, the days that have guide data, clock), the focused programme, then the grid. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tentacle_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/liveTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/lbl_guide_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/viewToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/guide_toggle_bg"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/viewFavorites"
                style="@style/GuideChip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:nextFocusLeft="@id/viewFavorites"
                tools:text="Favorites 3" />

            <TextView
                android:id="@+id/viewAll"
                style="@style/GuideChip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                tools:text="All 5,669" />
        </LinearLayout>

        <!-- Multi-view: pick 2-4 channels in the guide, then Start (becomes "2 of 4 · Start") -->
        <TextView
            android:id="@+id/multiViewButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:drawableStart="@drawable/guide_ic_multiview"
            android:text="@string/lbl_multiview" />

        <!-- One way into Recordings (Recorded | Scheduled | Series), #203 -->
        <TextView
            android:id="@+id/recordingsButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/guide_ic_record"
            android:text="@string/lbl_recordings" />

        <!-- Today … the last day with real guide data (hidden when only today has data), at the
             right end, so Multi-view and Recordings stay next to Favorites | All (Lucas, 25 Oct).
             Takes the room left: a long run of days scrolls in here, a short one sits on the right. -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:fillViewport="true"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/days"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <org.jellyfin.androidtv.ui.ClockUserView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- What is wrong with Live TV, in the server's words (GuideStatusBanner): one calm line,
         gone when there is nothing to say. What sits under the header sits under it. -->
    <TextView
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/guide_status_warning_bg"
        android:ellipsize="end"
        android:focusable="false"
        android:fontFamily="sans-serif"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textColor="@color/guide_status_warning_text"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="IPTV Bears is down right now (their server isn't answering) since 6:30 PM. Not a problem with your account or your setup."
        tools:visibility="visible" />

    <!-- Multi-view pick mode: what is picked and how to go on; over the focused programme -->
    <LinearLayout
        android:id="@+id/multiViewBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_below="@id/statusBanner"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@color/tentacle_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/multiViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/multiview_pick_title"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/multiViewPicked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tentacle_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/multiViewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/multiview_pick_hint"
            android:textColor="@color/guide_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- The live preview (GuidePreview), under the picture: shown by hiding the picture once the
         video's first frame is drawn. Gone while previews can't run. -->
    <SurfaceView
        android:id="@+id/previewSurface"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_below="@id/statusBanner"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:focusable="false"
        android:visibility="gone" />

    <!-- The focused programme -->
    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/programImage"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_below="@id/statusBanner"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/programImage"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:layout_toEndOf="@id/programImage"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/programTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_alignStart="@id/title"
        android:layout_marginEnd="12dp"
        android:maxLines="1"
        android:textColor="@color/tentacle_accent"
        android:textSize="14sp"
        tools:text="2:00 – 4:30 PM" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignTop="@id/programTime"
        android:layout_toStartOf="@id/resetButton"
        android:layout_toEndOf="@id/programTime"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/programTime"
        android:layout_alignStart="@id/title"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@id/resetButton"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:textColor="@color/guide_text_muted"
        android:textSize="14sp" />

    <!-- Back to now, after paging ahead -->
    <ImageButton
        android:id="@+id/resetButton"
        style="@style/Button.Icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignBottom="@id/programImage"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:background="@drawable/jellyfin_button"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_time"
        android:visibility="gone" />

    <!-- Timeline: the day shown, the half hours and a "now" pill -->
    <TextView
        android:id="@+id/displayDate"
        android:layout_width="160sp"
        android:layout_height="32dp"
        android:layout_below="@id/programImage"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:background="@color/timeline_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:textColor="@color/guide_text_muted"
        android:textSize="13sp"
        tools:text="Today" />

    <HorizontalScrollView
        android:id="@+id/timelineHScroller"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignTop="@id/displayDate"
        android:layout_toEndOf="@id/displayDate"
        android:background="@color/timeline_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/timeline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/nowPill"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/guide_now_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="2:56 PM" />
        </FrameLayout>
    </HorizontalScrollView>

    <org.jellyfin.androidtv.ui.ObservableScrollView
        android:id="@+id/channelScroller"
        android:layout_width="160sp"
        android:layout_height="match_parent"
        android:layout_below="@id/displayDate"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="20sp"
        android:background="@color/channel_scroller_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/channels"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:orientation="vertical" />
    </org.jellyfin.androidtv.ui.ObservableScrollView>

    <org.jellyfin.androidtv.ui.ObservableScrollView
        android:id="@+id/programVScroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/channelScroller"
        android:layout_alignBottom="@id/channelScroller"
        android:layout_toEndOf="@id/channelScroller"
        android:background="@color/program_scroller_bg"
        android:scrollbars="none">

        <org.jellyfin.androidtv.ui.ObservableHorizontalScrollView
            android:id="@+id/programHScroller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/programRows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- "Now" -->
                <View
                    android:id="@+id/nowLine"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/tentacle_accent"
                    android:focusable="false"
                    android:visibility="gone" />
            </FrameLayout>
        </org.jellyfin.androidtv.ui.ObservableHorizontalScrollView>
    </org.jellyfin.androidtv.ui.ObservableScrollView>

    <TextView
        android:id="@+id/channelsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/guide_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/filterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:textColor="@color/guide_text_muted"
        android:textSize="12sp" />

    <!-- Favorites with none yet: one plain line and the way to All -->
    <LinearLayout
        android:id="@+id/emptyFavorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/statusBanner"
        android:background="@color/tentacle_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="72dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/emptyFavoritesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/msg_guide_no_favorites"
            android:textColor="@color/guide_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/showAllButton"
            style="@style/GuideChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/lbl_guide_show_all" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/spinner"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/statusBanner"
        android:background="@color/tentacle_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="120dp"
            android:text="@string/lbl_loading_elipses"
            android:textColor="@color/guide_text_muted"
            android:textSize="16sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView9"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:indeterminateTint="@color/tentacle_accent" />

    </RelativeLayout>

</RelativeLayout>
